<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>es.uclm</groupId>
    <artifactId>StayOn</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>war</packaging>

    <!-- ✅ Personalización Maven Site -->
    <name>StayOnSL</name>
    <description>Sistema de alquiler de viviendas entre particulares desarrollado con Spring Boot</description>
    <!-- Cambia esta URL por la real del repo -->
    <url>https://github.com/USUARIO/StayOnSL</url>

    <!-- ✅ Información del equipo (Project Information -> Team) -->
    <developers>
        <developer>
            <name>Zaida Burgos Rodríguez</name>
            <roles><role>Owner</role></roles>
        </developer>
        <developer>
            <name>Jesús Pulido Hernández</name>
            <roles><role>Developer</role></roles>
        </developer>
        <developer>
            <name>Erika Macarro García</name>
            <roles><role>Developer</role></roles>
        </developer>
        <developer>
            <name>Jaime García de las Heras</name>
            <roles><role>Scrum Master</role></roles>
        </developer>
    </developers>

    <!-- ✅ SCM (Project Information -> Source Code Management) -->
    <scm>
        <!-- Cambia estas URLs por las reales del repo -->
        <connection>scm:git:https://github.com/USUARIO/StayOnSL.git</connection>
        <developerConnection>scm:git:https://github.com/USUARIO/StayOnSL.git</developerConnection>
        <url>https://github.com/zzzaaii/StayOnSL</url>
    </scm>

    <!-- ✅ (Opcional) Gestión de incidencias -->
    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/zzzaaii/StayOnSL/issues</url>
    </issueManagement>

    <!-- ✅ (Opcional) Licencia (para que no salga vacío) -->
    <licenses>
        <license>
            <name>Uso académico</name>
            <url>https://uclm.es</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <java.version>21</java.version>
        <start-class>es.uclm.StayOn.StayOnApplication</start-class>

        <!-- SonarCloud -->
        <sonar.projectKey>stayonsl1_StayOnSL</sonar.projectKey>
        <sonar.organization>stayonsl1</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>

        

        <!-- Integración JaCoCo + Sonar -->
        <sonar.java.coveragePlugin>jacoco</sonar.java.coveragePlugin>
        <sonar.dynamicAnalysis>reuseReports</sonar.dynamicAnalysis>
        <sonar.jacoco.reportPath>${project.basedir}/target/jacoco.exec</sonar.jacoco.reportPath>
    </properties>

    <dependencies>
        <!-- Spring Boot Web & Thymeleaf -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Tomcat como provided -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Derby DB -->
        <dependency>
            <groupId>org.apache.derby</groupId>
            <artifactId>derby</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.derby</groupId>
            <artifactId>derbytools</artifactId>
        </dependency>

        <!-- Testing Spring Boot (incluye JUnit Jupiter, Mockito, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- NO añadimos junit-platform-launcher ni junit-jupiter extra
             para no romper la versión que gestiona Spring Boot / Surefire -->
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Codificación UTF-8 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Maven Site (para generar target/site) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <version>3.12.1</version>
            </plugin>

            <!-- Surefire: ejecución de tests con JUnit Platform -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>

            <!-- JaCoCo para cobertura (ejecuta el agente y genera informe) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <id>jacoco-initialize</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-site</id>
                        <phase>package</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Sonar Maven Plugin (para poder usar sonar:sonar) -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>3.11.0.3922</version>
            </plugin>
        </plugins>
    </build>

    <!-- Reporting: Surefire, JXR, JaCoCo, info del proyecto -->
    <reporting>
        <plugins>
            <!-- Información general del proyecto -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-project-info-reports-plugin</artifactId>
                <version>3.4.5</version>
            </plugin>

            <!-- Informe de resultados de los tests (Surefire) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>3.2.2</version>
                <configuration>
                    <skipEmptyReport>false</skipEmptyReport>
                </configuration>
            </plugin>

            <!-- Referencias cruzadas al código fuente -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jxr-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>

            <!-- Informe HTML de cobertura JaCoCo -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>report</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>
        </plugins>
    </reporting>

</project>
